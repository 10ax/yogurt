+// Yogurt: with a discrete graphics card and an integrated one (a desktop with an iGPU driving the displays, a gaming
+// laptop), the integrated one often comes first and transcription ran on it, many times slower. Count only discrete
+// cards when there is one; with none, integrated ones count as before (Apple Silicon, most laptops).
+static bool whisper_dev_is_counted_gpu(ggml_backend_dev_t dev) {
+    const enum ggml_backend_dev_type t = ggml_backend_dev_type(dev);
+    if (t == GGML_BACKEND_DEVICE_TYPE_GPU) return true;
+    if (t != GGML_BACKEND_DEVICE_TYPE_IGPU) return false;
+    for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+        if (ggml_backend_dev_type(ggml_backend_dev_get(i)) == GGML_BACKEND_DEVICE_TYPE_GPU) return false;
+    }
+    return true;
+}
